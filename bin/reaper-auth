#!/usr/bin/env bash
#
# reaper-auth: Master Biometric & Sovereign Authentication Engine CLI.
# Unified manager for Face ID, Multi-Device Fingerprints, Remote SSH Biometrics,
# and Access Level Hierarchies (Level 1: Owner, Level 2: Partner/Second-in-Command, Level 3: Guest).
#

VERSION="1.1.0"

PURPLE="\033[1;35m"
BLUE="\033[1;34m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
CYAN="\033[1;36m"
BOLD="\033[1m"
RESET="\033[0m"

CONFIG_FILE="/etc/reaper-biometrics/aliases.json"
USER_CONFIG="$HOME/.config/reaper-biometrics/aliases.json"

[ -f "$USER_CONFIG" ] && ACTIVE_CONFIG="$USER_CONFIG" || ACTIVE_CONFIG="$CONFIG_FILE"

print_banner() {
    echo -e "${PURPLE}================================================================${RESET}"
    echo -e "${BLUE} 🛡️  REAPER AUTH ENGINE: Sovereign Multi-Tier Biometrics v${VERSION}${RESET}"
    echo -e "${PURPLE}================================================================${RESET}"
}

cmd_status() {
    print_banner
    echo -e "\n${BLUE}=== 1. Hardware Sensors & Drivers ===${RESET}"
    if command -v howdy >/dev/null 2>&1; then
        echo -e "  • Face ID (Howdy)          : ${GREEN}✓ Active & Configured${RESET}"
    else
        echo -e "  • Face ID (Howdy)          : ${YELLOW}○ Not Installed${RESET}"
    fi

    if command -v fprintd-list >/dev/null 2>&1; then
        FPOUT=$(fprintd-list "$USER" 2>/dev/null || true)
        if echo "$FPOUT" | grep -q "found"; then
            DEVS=$(echo "$FPOUT" | grep -c "Using device" || echo "1")
            echo -e "  • Fingerprint Subsystem    : ${GREEN}✓ Active (${DEVS} physical sensors armed)${RESET}"
        else
            echo -e "  • Fingerprint Subsystem    : ${YELLOW}○ No sensors detected${RESET}"
        fi
    fi

    if [ -f "/usr/local/lib/libfprint_bz3_override.so" ]; then
        echo -e "  • Bozorth3 Tuner (14/40)   : ${GREEN}✓ Active & Armed${RESET}"
    else
        echo -e "  • Bozorth3 Tuner (14/40)   : ${YELLOW}○ Not Compiled${RESET}"
    fi

    echo -e "\n${BLUE}=== 2. SSH Biometric Passthrough ===${RESET}"
    if [ -x "/usr/local/bin/reaper-ssh-askpass" ]; then
        echo -e "  • SSH Biometric Hook       : ${GREEN}✓ Installed (/usr/local/bin/reaper-ssh-askpass)${RESET}"
    else
        echo -e "  • SSH Biometric Hook       : ${YELLOW}○ Not Installed${RESET}"
    fi

    SOCK="${SSH_AUTH_SOCK:-}"
    if [ -n "$SOCK" ] && [ -S "$SOCK" ]; then
        echo -e "  • Active Agent Socket      : ${GREEN}✓ ${SOCK}${RESET}"
    else
        echo -e "  • Active Agent Socket      : ${YELLOW}○ Inactive or not set${RESET}"
    fi

    echo -e "\n${BLUE}=== 3. Master Access Hierarchy & Users ===${RESET}"
    if [ -f "$ACTIVE_CONFIG" ] && command -v jq >/dev/null 2>&1; then
        jq -r '.aliases | to_entries[] | "  • " + .value.badge + " " + .key + " (Level " + (.value.level|tostring) + "): Face=" + (.value.face_auth|tostring) + " | Prints=" + (.value.fingerprint_auth|tostring)' "$ACTIVE_CONFIG" 2>/dev/null
    else
        echo -e "  • Registered Users: ${GREEN}mr-reaper${RESET} (Level 1: Primary Owner), ${CYAN}rinnythepooh${RESET} (Level 2: Second in Command)"
    fi

    echo -e "\n${BLUE}=== 4. Master PAM Authentication Stack ===${RESET}"
    if [ -f "/etc/pam.d/sudo" ]; then
        PAMSUDO=$(cat /etc/pam.d/sudo)
        echo -ne "  • Sudo PAM Pipeline        : "
        echo -e "${GREEN}SSH Biometrics${RESET} ➔ ${CYAN}Face ID${RESET} ➔ ${PURPLE}Multi-Print (Bozorth3 14/40)${RESET} ➔ ${YELLOW}Unix Password${RESET}"
    fi
    echo ""
}

cmd_users() {
    print_banner
    echo -e "\n${BLUE}Registered Biometric Identities & Access Levels:${RESET}\n"
    if [ -f "$ACTIVE_CONFIG" ] && command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json
with open('$ACTIVE_CONFIG') as f:
    data = json.load(f)

levels = data.get('access_levels', {})
aliases = data.get('aliases', {})
fmap = data.get('finger_map', {}).get('$USER', {})

for alias, info in aliases.items():
    lvl = str(info.get('level', 1))
    lvl_info = levels.get(lvl, {})
    badge = info.get('badge', '')
    desc = lvl_info.get('description', '')
    name = lvl_info.get('name', f'Level {lvl}')
    
    # Count enrolled fingers
    user_fingers = [k for k, v in fmap.items() if v.get('alias') == alias]
    
    print(f'  {badge} \033[1m{alias}\033[0m — \033[1;36m{name}\033[0m')
    print(f'     ↳ Description : {desc}')
    print(f'     ↳ Face Auth   : {\"Enabled\" if info.get(\"face_auth\") else \"Disabled\"}')
    print(f'     ↳ Fingerprints: {len(user_fingers)} mapped ({ \", \".join(user_fingers) if user_fingers else \"None\" })')
    
    # Permissions
    perm = data.get('permissions', {}).get(alias, {})
    if perm:
        print(f'     ↳ Sudo Mode   : {perm.get(\"sudo_mode\", \"unrestricted\")}')
        if perm.get('sudo_whitelist'):
            print(f'     ↳ Whitelist   : {len(perm[\"sudo_whitelist\"])} permitted root commands')
    print()
"
    fi
}

cmd_add_user() {
    print_banner
    echo -e "\n${BLUE}➕ Add / Enroll New Biometric Identity Wizard${RESET}\n"
    read -rp "Enter alias or name for the user (e.g. rinnythepooh, alice): " NEW_ALIAS
    if [ -z "$NEW_ALIAS" ]; then
        echo -e "${RED}❌ Alias cannot be empty.${RESET}"
        exit 1
    fi

    echo -e "\nSelect Access Level Hierarchy:"
    echo -e "  ${BOLD}1${RESET}) Level 1: Primary Owner (Full Root, Unrestricted Sudo, Polkit Admin, Face ID)"
    echo -e "  ${BOLD}2${RESET}) Level 2: Second in Command (Desktop/Lockscreen Unlock, Whitelisted Sudo, Fingerprint Only)"
    echo -e "  ${BOLD}3${RESET}) Level 3: Limited Access (Desktop/Lockscreen Unlock Only, No Sudo Privileges)"
    read -rp "Choose Level [1-3] (Default: 2): " CHOSEN_LEVEL
    CHOSEN_LEVEL="${CHOSEN_LEVEL:-2}"

    read -rp "Enter emoji badge icon (e.g. 👑, 💖, 👤) [Default: 👤]: " BADGE
    BADGE="${BADGE:-👤}"

    echo -e "\n${GREEN}Configuring ${NEW_ALIAS} at Level ${CHOSEN_LEVEL}...${RESET}"

    if [ -f "$ACTIVE_CONFIG" ]; then
        python3 -c "
import json
with open('$ACTIVE_CONFIG', 'r') as f:
    data = json.load(f)

data.setdefault('aliases', {})['$NEW_ALIAS'] = {
    'alias': '$NEW_ALIAS',
    'level': int('$CHOSEN_LEVEL'),
    'unix_account': '$USER',
    'badge': '$BADGE',
    'face_auth': True if '$CHOSEN_LEVEL' == '1' else False,
    'fingerprint_auth': True
}

if '$CHOSEN_LEVEL' == '2':
    data.setdefault('permissions', {})['$NEW_ALIAS'] = {
        'desktop_login': True,
        'lockscreen_unlock': True,
        'polkit_admin': False,
        'sudo_mode': 'whitelist',
        'sudo_whitelist': [
            '/usr/bin/apt update',
            '/usr/bin/systemctl status',
            '/usr/bin/reboot'
        ]
    }
elif '$CHOSEN_LEVEL' == '3':
    data.setdefault('permissions', {})['$NEW_ALIAS'] = {
        'desktop_login': True,
        'lockscreen_unlock': True,
        'polkit_admin': False,
        'sudo_mode': 'disabled'
    }

with open('$ACTIVE_CONFIG', 'w') as f:
    json.dump(data, f, indent=2)

print('✓ Saved profile to $ACTIVE_CONFIG')
"
    fi

    echo -e "\n${YELLOW}Would you like to enroll a fingerprint for ${NEW_ALIAS} now? [Y/n]: ${RESET}"
    read -rp "" ENROLL_FP
    if [[ "$ENROLL_FP" =~ ^[Yy]?$ ]]; then
        reaper-fingerprint enroll
    fi
}

cmd_test() {
    print_banner
    echo -e "\n${YELLOW}Testing live biometric verification pipeline...${RESET}"
    if [ -x "/usr/local/bin/reaper-ssh-askpass" ]; then
        /usr/local/bin/reaper-ssh-askpass "Reaper Auth Verification Test"
    elif [ -x "/usr/local/bin/reaper-fprint-auth" ]; then
        /usr/local/bin/reaper-fprint-auth "$USER"
    fi
}

cmd_setup_server() {
    print_banner
    echo -e "\n${BLUE}Arming server for remote biometric passthrough...${RESET}"
    sudo apt-get update -qq
    sudo apt-get install -y -qq libpam-ssh-agent-auth
    sudo mkdir -p /etc/sudoers.d
    echo 'Defaults env_keep += "SSH_AUTH_SOCK"' | sudo tee /etc/sudoers.d/ssh-agent-auth >/dev/null
    sudo chmod 440 /etc/sudoers.d/ssh-agent-auth

    if [ -f "/etc/pam.d/sudo" ]; then
        if ! grep -q "pam_ssh_agent_auth.so" /etc/pam.d/sudo; then
            sudo sed -i '1a auth    sufficient    pam_ssh_agent_auth.so file=%h/.ssh/authorized_keys' /etc/pam.d/sudo
        fi
    fi
    echo -e "${GREEN}✓ Server successfully armed for SSH biometrics!${RESET}\n"
}

case "${1:-status}" in
    status)
        cmd_status
        ;;
    users|list)
        cmd_users
        ;;
    add-user|enroll-user)
        cmd_add_user
        ;;
    test)
        cmd_test
        ;;
    setup-server)
        cmd_setup_server
        ;;
    *)
        echo "Usage: reaper-auth {status|users|add-user|test|setup-server}"
        ;;
esac
